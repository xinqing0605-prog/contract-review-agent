# 复制为 .env 或直接设为环境变量（脚本读取的是进程环境）

# 数据库路径（默认 backend/clauseguard.sqlite3）
# CLAUSEGUARD_DB=

# 数据目录：上传的原始文件与加密主密钥（默认 ./data）
# CLAUSEGUARD_DATA=

# 加密模型 API Key 的主密钥。生产必须显式设置并妥善保管；
# 不设置时会自动生成 data/.master.key，换机器后已保存的 Key 将无法解密。
# CLAUSEGUARD_SECRET=

# 走 HTTPS 时设为 1，Cookie 只在 HTTPS 下发送
# CLAUSEGUARD_SECURE_COOKIES=0

# 是否允许模型地址指向内网。本地 Ollama 需要 1；公网部署建议 0
# CLAUSEGUARD_ALLOW_PRIVATE_MODEL=1
